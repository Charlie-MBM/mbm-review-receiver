  const prev=store.get("kw_live",{})||{};
  const live={};
  ov.forEach(o=>{ const k=o.keyword; const prevPos=(prev[k]&&prev[k].p!=null)?prev[k].p:(KW[k]?KW[k].p:null);
    let d=null; if(o.position!=null&&prevPos!=null) d=prevPos-o.position;
    live[k]={p:o.position, kd:o.keyword_difficulty, v:o.volume, d:d, url:o.url}; });
  store.set("kw_live", live); store.set("kw_live_date", todayISO());
  markOk("ahrefs");
}
async function refreshAllLive(){
  const btn=document.getElementById("refreshBtn");
  if(btn){ btn.disabled=true; btn.textContent="↻ refreshing…"; }
  const jobs=[["ga4",refreshGA4],["gads",refreshAds],["ahrefs",refreshAhrefs]];
  for(const [k,fn] of jobs){
    try{ await withRetry(fn,2); }
    catch(e){ markErr(k,e); }
  }
  if(btn){ btn.disabled=false; btn.textContent="↻ Refresh live"; }
  refreshAll();
}

/* ---------- DATA ENTRY ---------- */
let activeTab="members";
function num(id){ const v=parseFloat(document.getElementById(id).value); return isNaN(v)?0:v; }
function fieldNum(label,id,val){ return '<div class="field"><label>'+label+'</label><input type="number" step="any" id="'+id+'" value="'+(val==null?"":val)+'"></div>'; }
function renderEntry(){
  const period=selectedPeriod(); const body=document.getElementById("entryBody");
  if(activeTab==="members"){
    const act=getActive()||{};
    body.innerHTML='<div class="small" style="margin-bottom:10px;line-height:1.7"><b>Active member totals</b> — the North Star. Enter today\'s counts from Hint (Members → filter Active). Saved with today\'s date; the Hint feed upgrade will overwrite this automatically once it ships. Aggregate counts only — never names.</div>'+
      '<div class="formgrid" style="max-width:520px">'+
      fieldNum("Active Concierge members","am_c",act.concierge)+
      fieldNum("Active Service-Only members","am_so",act.so)+
      '</div><div style="margin-top:12px"><button class="btn" id="saveActive">Save active counts</button> <span class="small" id="amNote">'+(act.as_of?("last saved "+escapeHtml(act.as_of)+" ("+escapeHtml(act.source||"manual")+")"):"never saved")+'</span></div>';
    document.getElementById("saveActive").onclick=()=>{
      // Full timestamp, not date-only: a date-only string compares BEFORE a same-day
      // feed timestamp, which silently made manual overrides impossible (found 2026-07-17).
      store.set("active:"+curPeriod(), {concierge:num("am_c"), so:num("am_so"), as_of:new Date().toISOString(), source:"manual"});
      refreshAll();
    };
  } else if(activeTab==="ads"){
    const a=getAds(period);
    let f='<div class="small" style="margin-bottom:10px">Per-platform ad numbers for <b>'+period+'</b>. Google auto-refreshes (GAQL, MTD); Meta &amp; Nextdoor come from the weekly Ads Manager pull. For Meta, "conversions" = <b>landing-page views</b>, not leads.</div>';
    f+='<table><tr><th>Platform</th><th class="num">Spend $</th><th class="num">Impressions</th><th class="num">Clicks</th><th class="num">Conv / LPV</th></tr>';
    PLATFORMS.forEach(p=>{ const d=a[p];
      f+='<tr><td>'+PLAT_LABEL[p]+'</td>'+
        '<td class="num"><input style="width:90px" type="number" step="0.01" id="ad_'+p+'_spend" value="'+(d.spend||"")+'"></td>'+
        '<td class="num"><input style="width:90px" type="number" id="ad_'+p+'_impressions" value="'+(d.impressions||"")+'"></td>'+
        '<td class="num"><input style="width:80px" type="number" id="ad_'+p+'_clicks" value="'+(d.clicks||"")+'"></td>'+
        '<td class="num"><input style="width:90px" type="number" id="ad_'+p+'_conversions" value="'+(d.conversions||"")+'"></td></tr>';
    });
    f+='</table><div style="margin-top:12px"><button class="btn" id="saveAds">Save ad numbers</button></div>';
    body.innerHTML=f;
    document.getElementById("saveAds").onclick=()=>{ PLATFORMS.forEach(p=>{ store.set("ads:"+period+":"+p,{spend:num("ad_"+p+"_spend"),impressions:num("ad_"+p+"_impressions"),clicks:num("ad_"+p+"_clicks"),conversions:num("ad_"+p+"_conversions")}); }); refreshAll(); };
  } else if(activeTab==="funnel"){
    const ff=getFunnel(period);
    body.innerHTML='<div class="small" style="margin-bottom:10px">Funnel overrides for <b>'+period+'</b>. Visits/taps/handoffs come from GA4, consults &amp; members from the Hint poller — edit here only to correct.</div>'+
      '<div class="formgrid">'+
      fieldNum("Site visits","fn_visits",ff.site_visits)+
      fieldNum("Booking taps","fn_book",ff.inq_booking)+
      fieldNum("Phone taps","fn_phone",ff.inq_phone)+
      fieldNum("Hint handoffs","fn_hand",ff.handoffs)+
      fieldNum("Consults booked","fn_consults",ff.consults)+
      fieldNum("New members","fn_members",ff.new_members)+
      '</div><div style="margin-top:12px"><button class="btn" id="saveFunnel">Save funnel</button></div>';
    document.getElementById("saveFunnel").onclick=()=>{ store.set("funnel:"+period,Object.assign(getFunnel(period),{site_visits:num("fn_visits"),inq_booking:num("fn_book"),inq_phone:num("fn_phone"),handoffs:num("fn_hand"),consults:num("fn_consults"),new_members:num("fn_members")})); refreshAll(); };
  } else if(activeTab==="settings"){
    const c=cfg();
    body.innerHTML='<div class="formgrid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">'+
      '<div class="field"><label>Ahrefs project ID</label><input id="set_pid" value="'+escapeHtml(c.project_id)+'"></div>'+
      '<div class="field"><label>Ahrefs domain</label><input id="set_dom" value="'+escapeHtml(c.ahrefs_domain)+'"></div>'+
      '</div><div style="margin-top:12px"><button class="btn" id="saveSettings">Save settings</button> <span class="small" id="setNote"></span></div>'+
      '<div class="banner info" style="margin-top:16px">Metric definitions, refresh mechanics and failure modes are documented in <b>mbm-review-receiver/DASHBOARD_METRICS.md</b> — the contract every refresh task follows.</div>';
    document.getElementById("saveSettings").onclick=()=>{ saveCfg({project_id:document.getElementById("set_pid").value.trim(),ahrefs_domain:document.getElementById("set_dom").value.trim()}); document.getElementById("setNote").textContent="saved ✓"; refreshAll(); };
  }
}

/* ---------- WIRING ---------- */
function buildPeriodPicker(){
  const ps=document.getElementById("periodSel"); const prevVal=ps.value;
  const periods=recentPeriods(18);
  ps.innerHTML=periods.map(p=>'<option value="'+p+'">'+p+'</option>').join("");
  if(prevVal && periods.indexOf(prevVal)>=0) ps.value=prevVal; else ps.value=curPeriod();
}
function renderFinance(){
  const F=SNAPSHOT.finance; if(!F) return;
  const el=document.getElementById("finance"); if(!el) return;
  setRangePill("finRange", F.month);
  const qb=srcState("qb"), hint=srcState("hint");
  const rev=(F.revenue&&F.revenue.mtd!=null)?+F.revenue.mtd:null;
  const cost=(F.costs&&F.costs.mtd!=null)?+F.costs.mtd:null;
  const net=(rev!=null&&cost!=null)?(rev-cost):null;
  const dash='<span style="color:var(--stale)">—</span>';
  let cards="";
  cards+=card("Revenue — collected (MTD)", rev!=null?fmtUSD(rev):dash,
    '<div class="small" style="margin-top:6px;line-height:1.6">'+escapeHtml(F.revenue.basis)+
    (rev==null?'<br><b>Not wired yet:</b> lands with the next Hint feed run (exporter v4 revenue pull).':'')+'</div>',
    false, rev!=null?("Hint · as of "+escapeHtml(F.revenue.as_of||"")):"awaiting first pull");
  cards+=card("Costs — booked (MTD)", cost!=null?fmtUSD(cost):dash,
    '<div class="small" style="margin-top:6px;line-height:1.6">'+escapeHtml(F.costs.basis)+
    (cost==null?'<br><b>Not wired yet:</b> reconnect the QuickBooks connector, then the daily task pulls P&L expenses.':'')+'</div>',
    qb&&qb.cls==="stale"&&cost!=null, cost!=null?("QuickBooks · as of "+escapeHtml(F.costs.as_of||"")):"awaiting QuickBooks re-auth");
  cards+=card("Net (MTD)", net!=null?('<span style="color:'+(net>=0?'var(--good)':'var(--bad)')+'">'+fmtUSD(net)+'</span>'):dash,
    '<div class="small" style="margin-top:6px;line-height:1.6">'+(net!=null?('margin '+(rev>0?Math.round(net/rev*100)+'%':'—')+' · '):'')+escapeHtml(F.caveat)+'</div>',
    false, net!=null?"computed":"needs both sides wired", true);
  el.innerHTML=cards;
}
function renderLeadMagnet(){
  const K=SNAPSHOT.kit; const el=document.getElementById("leadMagnet"); if(!el||!K) return;
  const kc=srcState("kit");
  const n=(K.checklist_signups_mtd!=null)?fmtN(K.checklist_signups_mtd):'—';
  const tot=(K.list_total!=null)?fmtN(K.list_total):'—';
  el.innerHTML='<div style="display:flex;flex-wrap:wrap;gap:18px;align-items:baseline">'+
    '<div><span class="k" style="font-weight:600">CHECKLIST SIGNUPS (KIT)</span> <span style="font-size:26px;font-weight:700;margin-left:8px">'+n+'</span> <span class="small">MTD</span></div>'+
    '<div class="small">list total <b>'+tot+'</b></div>'+
    '<div class="small" style="flex:1">'+escapeHtml(K.note)+(K.checklist_signups_mtd==null?' · <b>Not wired yet:</b> reconnect Kit (Zapier), then the daily task pulls signups.':'')+'</div>'+
    '<div class="asof" style="margin:0">Kit · '+(kc&&kc.asof?fmtAge(kc.ageH):"never pulled")+'</div></div>';
}
function refreshAll(){ renderStatus(); renderFinance(); renderLeadMagnet(); renderNorthStar(); renderFunnel(); renderMemberSource(); renderPaid(); renderGBP(); renderSEO(); renderEntry(); }
function init(){
  buildPeriodPicker();
  document.getElementById("periodSel").onchange=refreshAll;
  document.getElementById("refreshBtn").onclick=()=>refreshAllLive();
  document.querySelectorAll("#entryTabs .tab").forEach(t=>{ t.onclick=()=>{ document.querySelectorAll("#entryTabs .tab").forEach(x=>x.classList.remove("active")); t.classList.add("active"); activeTab=t.dataset.tab; renderEntry(); }; });
  document.getElementById("foot").innerHTML='Every tile carries its source and as-of date; hatched tiles are serving last-good (stale) values. Baked snapshot '+escapeHtml(SNAPSHOT.baked_at)+' · data version '+escapeHtml(DATA_VERSION)+'. Definitions &amp; refresh contract: <b>mbm-review-receiver/DASHBOARD_METRICS.md</b>. Windows are true month-to-date unless a tile says otherwise. Trend arrows are deliberately absent from small counts — a one-member swing is 33% noise, not a trend.';
  seedRealData();
  refreshAll();
}
function boot(){
  try{ init(); }
  catch(e){
    var b=document.createElement('div');
    b.style.cssText='font-family:monospace;font-size:12px;background:#fbeeea;color:#b4452f;padding:14px;margin:14px;border:1px solid #b4452f;border-radius:8px;white-space:pre-wrap';
    b.textContent='Dashboard error (please send this to Claude):\n'+(e&&e.message||e)+'\n\n'+(e&&e.stack||'');
    if(document.body) document.body.insertBefore(b, document.body.firstChild);
  }
}
if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",boot); else boot();
</script>
