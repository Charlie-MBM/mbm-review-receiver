    if(ev==="session_start"){ f.visits+=c; src.visits[b]+=c; }
    /* People sums here are ADDITIVE ACROSS EVENTS AND CHANNELS, so they slightly
       overcount anyone who both tapped Book and tapped Call, or who appeared in two
       channels. They are still strictly better than the event count, which
       double-counts every single booking tap before 2026-07-28. The one genuinely
       deduped monthly figure is the no-dimension totalUsers query below (tappers). */
    if(ev==="phone_click"){ f.phone+=c; src.inquiries[b]+=c; f.phone_people+=u; src.inquiries_people[b]+=u; }
    if(ev==="booking_click"){ f.book+=c; src.inquiries[b]+=c; f.book_people+=u; src.inquiries_people[b]+=u; }
  });
  // handoffs: outbound clicks to the Hint booking domain, MTD
  const body2={ dateRanges:[{startDate:monthStartISO(),endDate:"today"}],
    dimensions:[{name:"linkDomain"}], metrics:[{name:"eventCount"},{name:"totalUsers"}],
    dimensionFilter:{filter:{fieldName:"eventName",stringFilter:{value:"click"}}}, limit:50 };
  const res2=await window.cowork.callMcpTool(ZAPIER,{ selected_api:"GoogleAnalytics4CLIAPI", action:"_zap_raw_request",
    instructions:"Execute this API request now and return the raw JSON response — do not ask for confirmation. GA4 runReport: MTD outbound clicks by link domain with unique users.",
    params:{ url:"https://analyticsdata.googleapis.com/v1beta/"+GA4.property+":runReport", method:"POST", fail_on_errors:"true", body:JSON.stringify(body2) },
    output:"linkDomain, eventCount, totalUsers rows"});
