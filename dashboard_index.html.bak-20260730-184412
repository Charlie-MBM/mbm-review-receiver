function periodShort(p){ const m=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]; const a=(p||"").split("-"); return a[1]?m[+a[1]-1]:""; }

/* ---------- VISITS CONTEXT STRIP (restored 2026-07-29) ----------
   Site visits used to be the first bar of the four-bar acquisition funnel; the
   2026-07-28 people-first rebuild removed it and left SNAPSHOT.funnel_mtd.visits,
   .visits_src and the whole "funnel_src:<period>" store key WRITE-ONLY (nothing
   read them). Reconstructed from the surviving pre-rebuild build in
   _dash_build.html (fbar()/srcSegs()/SRCC, lines ~425-493 there).
   It comes back as a CONTEXT STRIP above the funnel, not as a funnel stage:
   visits are SESSIONS and the stages below are PEOPLE, and stacking the two in one
   funnel is exactly the events-vs-people lie the rebuild set out to remove. */
const VISIT_SRC_C=[["organic","#144120","Organic search"],["direct","#4A8D66","Direct"],["google","#c7a14b","Google Ads"],["meta","#3b6ea5","Meta"],["other","#b8c2bb","Other"]];
function srcSegs(split, colors){
  let segs='', tot=0;
  colors.forEach(function(c){ tot+=+(split&&split[c[0]])||0; });
  colors.forEach(function(c){ const v=+(split&&split[c[0]])||0; if(v>0) segs+='<span style="flex:'+v+';background:'+c[1]+'" title="'+escapeHtml(c[2]||c[0])+': '+v+'"></span>'; });
  if(tot<=0) segs='<span style="flex:1;background:#d3dcd5"></span>';
  return segs;
}
function renderVisitsStrip(period, f){
  const el=document.getElementById("visitsStrip"); if(!el) return;
  const fs=store.get("funnel_src:"+period, null);
  const split=(fs&&fs.visits)||null;
  const v=+f.site_visits||0;
  const bar = v>0
    ? '<div class="fbar fbar-split"><span class="fnum">'+fmtN(v)+'</span>'+srcSegs(split,VISIT_SRC_C)+'</div>'
    : '<div class="fbar fbar-empty">0 <span class="fsub">no GA4 visits recorded for this period</span></div>';
  const leg=VISIT_SRC_C.map(function(c){ const n=+(split&&split[c[0]])||0; return n>0?('<span><i style="background:'+c[1]+'"></i>'+escapeHtml(c[2])+' '+fmtN(n)+'</span>'):''; }).join('');
  el.innerHTML='<div class="small" style="font-weight:600;font-size:13px;color:var(--forest);margin-bottom:8px">Site visits \u2014 context for the funnel below '
    +'<span class="small" style="font-weight:400;color:var(--muted)">GA4 <span class="vcode">session_start</span>, month to date, split by session channel. These are SESSIONS, not people, and not a funnel stage \u2014 most visitors never intend to book, so a visits bar stacked on the booking stages would invent a conversion rate that means nothing.</span></div>'
    +bar+(leg?'<div class="mixlegend" style="margin-top:8px">'+leg+'</div>':'');
}

/* ---------- FUNNEL ---------- */
function renderFunnel(){
  const period=selectedPeriod(); const f=getFunnel(period);
  setRangePill("funnelRange", period);
  renderVisitsStrip(period, f);
  const ch=store.get("consults_hint:"+period, null);
  const taps=(+f.inq_booking||0)+(+f.inq_phone||0);
  const consults=(ch&&(ch.scheduled_mtd!=null?ch.scheduled_mtd:ch.scheduled))||(+f.consults||0);

  /* PEOPLE-FIRST BOOKING FUNNEL (rebuilt 2026-07-28).
     One vertical list driven by SNAPSHOT.funnel_mtd.booking_since_cutover — the
     Jul 18–27 window is the only one where GA4 sees the whole on-site flow.
     PEOPLE (totalUsers) are the headline number; EVENTS ride along muted, because
     events-per-person differs at every stage and an events-only funnel lies.
     The worst step-over-step drop is COMPUTED below, never hardcoded. */
  const bc=SNAPSHOT.funnel_mtd.booking_since_cutover;
  /* Window length is COMPUTED, never typed. The caption read "10 days" against a
     Jul 18-28 window on 2026-07-30 because it was hardcoded when the window ended
     on the 27th. */
  const bcDays=(function(){
    const a=Date.parse(bc.window_start+"T00:00:00Z"), b=Date.parse(bc.window_end+"T00:00:00Z");
    return (isFinite(a)&&isFinite(b))?Math.round((b-a)/86400000)+1:null;
  })();
  const st=[
    {lab:"Visited the site",             ev:"session_start",           people:bc.visitors_people,         events:bc.visitors_events, reach:true},
    /* input:true -- a SIGNAL, not a nested stage. Taps and page-arrivals are
       different populations: the front-desk bookmark (?staff=1), the Spruce
       confirmation link, the GBP profile link and typed/bookmarked URLs all land
       on /book-beta with no tap, and people = unique BROWSERS, so a tap on a phone
       that finishes on a laptop is two users only one of whom tapped. On
       2026-07-30 this row read 53 against the page row's 56 and the funnel
       rendered "106% of the step before". No ratio between these two is honest. */
    {lab:'Tapped "Book a free consult"', ev:"booking_click",           people:bc.clicks_people,           events:bc.clicks_events, input:true},
    /* funnelStart:true -- the nested funnel begins HERE, not at the tap.
       booking_start is a PAGEVIEW ALIAS, not an action: it fires on load and
       matches the /book-beta page counters exactly (98 events vs 98 page_views,
       56 people vs 56 page_users, GA4 2026-07-29). Read it as "reached the page";
       it is never evidence anyone began booking. */
    {lab:"Reached the booking page",     ev:"booking_start",           people:bc.starts_people,           events:bc.starts_events, funnelStart:true},
    {lab:"Picked a time",                ev:"booking_step_1",          people:bc.step1_people,            events:bc.step1_events},
    {lab:"Entered their details",        ev:"booking_step_2",          people:bc.step2_people,            events:bc.step2_events},
    {lab:"Booked",                       ev:"booking_complete_server", people:bc.completes_server_people, events:bc.completes_server_events}
  ];
  /* worst-drop is computed only WITHIN the on-site booking flow (never the
     visit→tap step): every site loses ~95% of visitors before they tap, so
     flagging that as "biggest drop" would bury the real in-funnel leak. The
     visit→tap conversion still renders on the tap row, just isn't flagged. */
  let worst=-1, worstDrop=null;
  for(let i=1;i<st.length;i++){
    /* The row that STARTS the nested funnel has no honest "of the step before":
       the row above it is an input signal over a different population, not a
       superset of it. */
    if(st[i].funnelStart) continue;
    const prev=st[i-1].people, cur=st[i].people;
    if(prev>0 && cur!=null){
      const conv=(cur/prev)*100;
      /* Guard for this class of bug anywhere else in the list. If a stage exceeds
         the one above it the two are not nested, and printing 106% would assert a
         funnel that grows. Say what is actually true instead. */
      if(conv>100){ st[i].notNested=true; continue; }
      st[i].conv=conv;
      const drop=100-conv;
      if(!st[i-1].reach && !st[i-1].input && drop>0 && (worstDrop==null || drop>worstDrop)){ worstDrop=drop; worst=i; }
    }
  }
  /* bars are scaled to the booking sub-funnel (reach row excluded), so the
     1,000+ visitor count doesn't crush the 9-people stages into invisibility —
     same reason the GSC reach band is a line, not a bar. Reach bar is clamped. */
  const pmax=Math.max.apply(null, st.filter(s=>!s.reach).map(s=>+s.people||0).concat([1]));
  let html="";
  for(let i=0;i<st.length;i++){
    const s=st[i], bad=(i===worst);
    const w=Math.min(100,Math.max(2,((+s.people||0)/pmax)*100));
    html+='<div class="vstage'+(bad?' worst':'')+'">'+
      '<div class="vnum">'+fmtN(s.people)+'<small>people</small></div>'+
      '<div><div class="vlab">'+escapeHtml(s.lab)+'</div>'+
        '<div class="vev">'+fmtN(s.events)+' events · <span class="vcode">'+escapeHtml(s.ev)+'</span></div>'+
        '<div class="vbar"><span style="width:'+w+'%'+(s.reach?';background:#cdd8d0':'')+'"></span></div></div>'+
      '<div class="vconv">'+(s.conv==null
        ? '<span class="vstart">'+(s.reach?'reach — everyone who visited'
            :s.notNested?'not nested — exceeds the step above'
            :s.funnelStart?'start of the booking flow'
            :s.input?'input signal, not a stage'
            :'start of funnel')+'</span>'
        : '<b>'+Math.round(s.conv)+'%</b>of the step before'+(bad?'<span class="vdrop">biggest drop −'+Math.round(100-s.conv)+'%</span>':''))+
      '</div></div>';
  }
  /* Side signal, deliberately BELOW the funnel and visually separated: it is a
     REASON people leave, not a stage they pass through. null renders "not yet
     measured", never 0 (DASHBOARD_METRICS.md §0.4 — zero ≠ null). */
  const unP=bc.unavailable_people, unE=bc.unavailable_events;
  html+='<div class="vsep"><div class="vseplab">Why they drop — side signal, not a stage</div>'+
    '<div class="vstage vaside">'+
      '<div class="vnum'+(unP==null?' vnull':'')+'">'+(unP==null?'—':fmtN(unP))+'<small>'+(unP==null?'not yet measured':'people')+'</small></div>'+
      '<div><div class="vlab">Saw no available times</div>'+
        '<div class="vev">'+(unE==null
          ? '<span class="vcode">booking_unavailable</span> shipped 2026-07-28 — no data yet'
          : fmtN(unE)+' events · <span class="vcode">booking_unavailable</span>')+'</div></div>'+
      '<div class="vconv"><span class="vstart">'+(unP==null?'awaiting first data':'of everyone who reached the page')+'</span></div>'+
    '</div></div>';
  html+='<div class="vcav"><b>booking_click double-counted roughly 2.3× through 2026-07-28</b> — a capture-phase listener and the onClick handler both fired on every tap (fixed in commit 2529b3c), so that series is not comparable across that date. <b>Bookings are counted server-side</b> (<span class="vcode">booking_complete_server</span>) because the client-side <span class="vcode">booking_complete</span> is suppressed by ad blockers and undercounts — '+fmtN(bc.completes_events)+' events / '+fmtN(bc.completes_people)+' people client-side against '+fmtN(bc.completes_server_events)+' / '+fmtN(bc.completes_server_people)+' server-side over the same window.'+
    '<div class="vwin">Window '+escapeHtml(bc.window_start)+' → '+escapeHtml(bc.window_end)+(bcDays?' ('+bcDays+' days since the /book-beta cutover)':' (since the /book-beta cutover)')+' · GA4, as of '+escapeHtml(bc.as_of)+' · people = totalUsers (unique browsers/devices; cross-device can double-count) · /book-beta page: '+fmtN(bc.page_views)+' views, '+fmtN(bc.page_users)+' active users.</div></div>';
  document.getElementById("funnel").innerHTML=html;

  // reach line — deliberately a LINE, not a funnel bar: impressions are reach, carry an
  // estimated organic component, and would dwarf the real stages into invisibility
  const rl=document.getElementById("reachLine");
  if(rl){
    const proj=projectMonth(SNAPSHOT.gsc.current);
    const paidImpr=SNAPSHOT.gads.mtd.impressions||0;
    const reach=(proj?proj.impressions:0)+paidImpr;
    rl.innerHTML='<b>Search reach this month: ~'+fmtN(reach)+' impressions</b> <span style="color:var(--muted)">('+fmtN(paidImpr)+' paid actual + ~'+fmtN(proj?proj.impressions:0)+' organic projected). Reach, not funnel — it sits up here so it can\'t dwarf the stages that matter below.</span>';
  }

  // leak box — counts PEOPLE where unique-user data exists; taps are events (~1.9/person)
  const uLive=store.get("funnel_users:"+period,null);
  const u=uLive||(period===SNAPSHOT.period?SNAPSHOT.funnel_mtd.users:null);
  let leakHtml;
  if(u && +u.tappers>0){
    const wq=wilson(consults, +u.tappers);
    const perPerson=taps>0?Math.round((taps/u.tappers)*10)/10:null;
    const lost=Math.max(0, +u.tappers - consults);
    const bk=(period===SNAPSHOT.period)?SNAPSHOT.funnel_mtd.booking_since_cutover:null;
    if(bk){
      const pgDrop=(bk.starts_people>0&&bk.step1_people!=null)?Math.round(100-(bk.step1_people/bk.starts_people)*100):null;
      const bkDays=(function(){
        const a=Date.parse(bk.window_start+"T00:00:00Z"), b=Date.parse(bk.window_end+"T00:00:00Z");
        return (isFinite(a)&&isFinite(b))?Math.round((b-a)/86400000)+1:null;
      })();
      /* The old copy asserted "1:1, there is no click-to-page leak" — true when
         both numbers were 49, false and unfixable as a claim once they diverged.
         Both numbers are now stated and the gap is explained where it exists. */
      const pageOverTap=(bk.clicks_people!=null&&bk.starts_people!=null)?(bk.starts_people-bk.clicks_people):null;
      leakHtml='Since the <b>2026-07-18 cutover</b> booking completes on our own site (/book-beta), so GA4 sees the whole flow. Over '+(bkDays?'the first <b>'+bkDays+'</b> days':'the window')+' ('+escapeHtml(bk.window_start)+' → '+escapeHtml(bk.window_end)+'): <b>'+fmtN(bk.clicks_people)+'</b> people tapped a booking CTA, <b>'+fmtN(bk.starts_people)+'</b> reached the booking page, and <b>'+fmtN(bk.completes_server_people)+'</b> came out the far end booked (server-confirmed).'+
        (pageOverTap!=null&&pageOverTap>0
          ? '<br><span class="small">More people reached the page ('+fmtN(bk.starts_people)+') than tapped a CTA ('+fmtN(bk.clicks_people)+'), which is expected rather than an error: the front-desk bookmark, the Spruce confirmation link, the GBP profile link and typed or bookmarked URLs all land on /book-beta without a tap, and a tap on a phone that finishes on a laptop counts as two browsers. Taps are an input signal, so the funnel starts at the page, not at the tap.</span>'
          : '')+
        '<br><b>The one real leak is the time picker:</b> of the '+fmtN(bk.starts_people)+' people who reached the page, only <b>'+fmtN(bk.step1_people)+'</b> picked a time — '+fmtN(pgDrop)+'% lost at a single step. Everything downstream holds: '+fmtN(bk.step1_people)+' picked a time → '+fmtN(bk.step2_people)+' entered details → '+fmtN(bk.completes_server_people)+' booked. Fix the time picker, not the CTA.'+
        '<div class="small" style="margin-top:6px;color:var(--stale)">People = GA4 totalUsers (unique browsers/devices; cross-device can double-count), as of '+escapeHtml(bk.as_of||'')+'. <b>booking_unavailable</b> shipped 2026-07-28 and will tell us how much of that '+fmtN(pgDrop)+'% is "no times offered" versus abandonment; until it has data it renders "not yet measured", never 0.</div>';
    } else {
      const wq=wilson(consults, +u.tappers);
      leakHtml='<b>'+fmtN(u.tappers)+'</b> people tried to book this period ('+fmtN(taps)+' taps'+(perPerson?(' — ~'+perPerson+' per person'):'')+'), and <b>'+fmtN(consults)+'</b> consults were booked in Hint ('+(wq?(Math.round(wq.p)+'%, range '+Math.round(wq.lo)+'–'+Math.round(wq.hi)+'%'):'—')+').'+
        '<div class="small" style="margin-top:6px;color:var(--stale)">People = GA4 totalUsers as of '+escapeHtml(u.as_of||'')+'. Taps = events.</div>';
    }
  } else {
    const w2=wilson(consults,taps);
    leakHtml='Of <b>'+fmtN(taps)+'</b> Book/Call taps this month (<b>events, not unique people</b> — people average ~1.9 taps each), <b>'+fmtN(consults)+'</b> consults were booked ('+(w2?Math.round(w2.p):'—')+'% of taps; the per-person rate is roughly double).'+
      '<br><span class="small" style="color:var(--stale)">Unique-person counts not available for this period. Booking CTAs land directly on Hint, so the drop is inside Hint\'s booking flow, not on the way there.</span>';
  }
  document.getElementById("leakBox").innerHTML=leakHtml;

  /* DAILY INTENT SERIES - people-first as of 2026-07-29.
     SNAPSHOT.daily.taps is eventCount and is inflated ~2.31x for every day through
     2026-07-28 (booking_click double-fire, fixed in commit 2529b3c), so the event
     series is NOT comparable across that date. daily.taps_people is the same days
     as GA4 totalUsers (dimension: date) - a double-fired tap dedupes to one person,
     so it is immune to the bug and comparable end to end. Prefer it; fall back to
     events ONLY with the basis line below saying so in plain words. Never scale the
     event series by a correction factor: 2.31 is a measured average, not a per-day
     truth, and a scaled series is a fabricated series. */
  const dP=SNAPSHOT.daily.taps_people;
  const dPeople=Array.isArray(dP)&&dP.length===SNAPSHOT.daily.dates.length;
  barsAndLine("chDaily", SNAPSHOT.daily.dates,
    [{label:dPeople?"People who tapped Book/Call":"Book/Call taps (events)", data:dPeople?dP:SNAPSHOT.daily.taps, backgroundColor:"#20713F"}]);
