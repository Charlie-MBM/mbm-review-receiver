<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mt. Baker Medical — Performance Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.js" integrity="sha384-iU8HYtnGQ8Cy4zl7gbNMOhsDTTKX02BTXptVP/vqAWIaTfM7isw76iyZCsjL2eVi" crossorigin="anonymous"></script>
<style>
  :root{
    color-scheme: light;
    --forest:#144120; --sage:#4A8D66; --lightsage:#94C1AB;
    --ink:#1c2b22; --muted:#5e6f64; --line:#e3e7e1; --bg:#FBFAF7; --card:#ffffff;
    --good:#2f7d50; --bad:#b4452f; --warn:#9a6b1f; --stale:#8a8f8a;
    /* series palette — validated (dataviz six checks, light surface) 2026-07-17 */
    --s-green:#20713F; --s-purple:#7059B3; --s-gold:#9C6F10; --s-blue:#2C6FC4; --s-terra:#C2703F;
    --shadow-1:0 1px 2px rgba(28,43,34,.05),0 6px 16px -10px rgba(28,43,34,.10);
    --shadow-2:0 3px 6px rgba(28,43,34,.06),0 12px 28px -12px rgba(28,43,34,.16);
    --display:'Cormorant Garamond',Georgia,'Times New Roman',serif;
    --body:'Source Serif 4',Georgia,'Times New Roman',serif;
    --label:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:linear-gradient(180deg,#F3F2EB 0,var(--bg) 300px);color:var(--ink);font-family:var(--body);line-height:1.5;font-size:15px}
  .wrap{max-width:1080px;margin:0 auto;padding:22px 22px 80px}
  header.top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;border-bottom:2px solid var(--forest);padding-bottom:14px;margin-bottom:8px;flex-wrap:wrap}
  .brand h1{font-family:var(--display);font-weight:600;color:var(--forest);margin:0;font-size:30px;letter-spacing:.2px;line-height:1.05}
  .brand .tag{font-family:var(--display);font-style:italic;color:var(--sage);font-size:18px;margin-top:2px}
  .brand .sub{font-family:var(--label);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:6px}
  .hdr-right{font-family:var(--label);font-size:12px;color:var(--muted);text-align:right}
  select,input{font-family:var(--label);font-size:13px;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:7px;padding:7px 9px}
  select:focus,input:focus{outline:2px solid var(--lightsage);outline-offset:0}
  h2.sec{font-family:var(--display);color:var(--forest);font-size:23px;font-weight:600;margin:34px 0 4px;display:flex;align-items:center;gap:10px}
  h2.sec .rule{flex:1;height:1px;background:var(--line)}
  .sec-note{font-family:var(--label);font-size:12px;color:var(--muted);margin:0 0 14px}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 17px;position:relative;box-shadow:var(--shadow-1);transition:box-shadow .18s ease,transform .18s ease}
  .card:hover{box-shadow:var(--shadow-2);transform:translateY(-1px)}
  .card .k{font-family:var(--label);font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
  .card .v{font-family:var(--label);font-weight:650;font-size:28px;color:var(--forest);margin-top:6px;letter-spacing:-.4px}
  .card .v.hero{font-size:48px;line-height:1.02;letter-spacing:-1.5px;font-weight:700}
  .card .v small{font-size:14px;color:var(--muted);font-weight:500}
  .card.stale{background:repeating-linear-gradient(135deg,#fff,#fff 9px,#f3f3ef 9px,#f3f3ef 12px)}
  .asof{font-family:var(--label);font-size:10px;color:var(--stale);margin-top:7px}
  .smalltag{font-family:var(--label);font-size:10px;font-weight:600;color:var(--muted);background:#eef1ec;border-radius:5px;padding:1px 6px;display:inline-block}
  .goalbar{height:10px;border-radius:6px;background:#E7EDE7;margin-top:12px;overflow:hidden;position:relative}
  .goalbar span{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,#1B5B34,#3E9464);transition:width .6s cubic-bezier(.2,.7,.3,1)}
  /* status strip */
  .status{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:13px 15px;margin-top:14px;box-shadow:var(--shadow-1)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{font-family:var(--label);font-size:11px;font-weight:600;border-radius:999px;padding:4px 12px 4px 10px;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:#fff;color:var(--muted);cursor:default;transition:border-color .15s}
  .chip:hover{border-color:#c9d3cb}
  .chip i{width:8px;height:8px;border-radius:50%;display:inline-block;box-shadow:0 0 0 3px rgba(0,0,0,.035)}
  .chip.fresh i{background:var(--good);box-shadow:0 0 0 3px rgba(47,125,80,.14)}
  .chip.aging i{background:#c9a227;box-shadow:0 0 0 3px rgba(201,162,39,.16)}
  .chip.stale i{background:var(--bad);box-shadow:0 0 0 3px rgba(180,69,47,.15)}
  .chip.manual i{background:#7a8a7d}
  .alert{font-family:var(--label);font-size:13px;border-radius:12px;padding:11px 14px 11px 13px;margin-top:10px;display:flex;gap:10px;align-items:flex-start;line-height:1.55}
  .alert.red{background:#fdf1ee;color:#7c2d1c;border:1px solid #eccabf;border-left:3px solid var(--bad)}
  .alert.amber{background:#fcf5e8;color:var(--warn);border:1px solid #ecd9b2;border-left:3px solid #c9a227}
  .alert.green{background:#f0f6f1;color:var(--forest);border:1px solid #cfe3d5;border-left:3px solid var(--good)}
  .alert b{font-weight:700}
  .banner{font-family:var(--label);font-size:13px;border-radius:10px;padding:12px 14px;display:flex;gap:10px;align-items:center}
  .banner.info{background:#eef4ef;color:var(--forest);border:1px solid var(--lightsage)}
  .banner.warn{background:#fbf3e6;color:var(--warn);border:1px solid #e7d3aa}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px;box-shadow:var(--shadow-1)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  /* funnel */
  .funnel{display:flex;flex-direction:column;gap:0}
  /* visits context strip (restored 2026-07-29) - the .fbar family survived from the
     pre-2026-07-28 four-bar funnel in _dash_build.html; the rebuild deleted the rules
     but left .fbar/.fbar-empty still emitted by renderMemberSource(), so its empty
     state was rendering unstyled. Restored here, used by both. */
  .fbar{height:34px;border-radius:8px;background:linear-gradient(90deg,var(--forest),var(--sage));display:flex;align-items:center;padding:0 12px;color:#fff;font-family:var(--label);font-size:13px;font-weight:600;min-width:54px}
  .fbar-split{padding:0;background:none;position:relative;overflow:hidden}
  .fbar-split .fnum{position:absolute;left:12px;top:0;height:100%;display:flex;align-items:center;color:#fff;font-weight:600;z-index:1;text-shadow:0 1px 2px rgba(0,0,0,.28)}
  .fbar-split>span:not(.fnum){display:block;height:100%}
  .fbar-empty{background:#e3e7e1;color:var(--muted)}
  .fbar-empty .fsub{font-weight:400;font-style:italic;margin-left:4px}
  /* funnel — vertical, people-first booking stages (rebuilt 2026-07-28).
     Same card language as .card/.panel: white, 1px --line, 12px radius. */
  .vstage{display:grid;grid-template-columns:96px 1fr auto;gap:16px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 15px;margin-bottom:8px}
  .vstage.worst{background:#fdf1ee;border-color:#eccabf;border-left:3px solid var(--bad);padding-left:13px}
  .vnum{font-family:var(--label);font-weight:650;font-size:30px;line-height:1;color:var(--forest);text-align:right;letter-spacing:-1px;font-variant-numeric:tabular-nums}
  .vstage.worst .vnum{color:var(--bad)}
  .vnum small{display:block;font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-top:5px}
  .vnum.vnull{color:var(--stale);font-weight:500}
  .vlab{font-family:var(--label);font-size:14px;font-weight:600;color:var(--ink)}
  .vev{font-family:var(--label);font-size:11px;color:var(--stale);margin-top:3px}
  .vcode{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:10.5px;color:var(--muted)}
  .vbar{height:6px;border-radius:4px;background:#E7EDE7;margin-top:8px;overflow:hidden;max-width:430px}
  .vbar span{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,#1B5B34,#3E9464)}
  .vstage.worst .vbar span{background:linear-gradient(90deg,#8f3a26,#c25a3e)}
  .vconv{font-family:var(--label);font-size:11px;color:var(--muted);text-align:right;white-space:nowrap;line-height:1.5}
  .vconv b{display:block;font-size:17px;font-weight:650;color:var(--forest);letter-spacing:-.3px}
  .vstage.worst .vconv b{color:var(--bad)}
  .vdrop{display:inline-block;margin-top:5px;font-size:10px;font-weight:700;color:#7c2d1c;background:#f6dcd3;border-radius:5px;padding:2px 7px}
  .vstart{color:var(--stale);font-style:italic}
  .vaside{background:#f7f8f5;border-style:dashed}
  .vsep{margin-top:16px;padding-top:14px;border-top:1px dashed var(--line)}
  .vseplab{font-family:var(--label);font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
  .vcav{font-family:var(--label);font-size:11.5px;color:var(--muted);line-height:1.85;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
  .vcav b{color:var(--ink);font-weight:650}
  .vwin{font-family:var(--label);font-size:10.5px;color:var(--stale);margin-top:8px;line-height:1.7}
  .mixlegend{display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:8px;font-family:var(--label);font-size:11px;color:var(--muted)}
  .mixlegend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:middle}
  /* tables */
  table{border-collapse:collapse;width:100%;font-family:var(--label);font-size:13px}
  th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
  th{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-weight:600}
  td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
  tr:hover td{background:#f6f8f5}
  .btn{font-family:var(--label);font-size:13px;font-weight:600;border:1px solid var(--forest);background:var(--forest);color:#fff;border-radius:8px;padding:8px 14px;cursor:pointer}
  .btn:hover{background:#0e3018}
  .btn.ghost{background:#fff;color:var(--forest)}
  .btn.sm{padding:4px 9px;font-size:12px}
  .btn.danger{border-color:var(--bad);color:var(--bad);background:#fff}
  .formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;align-items:end}
  .field{display:flex;flex-direction:column;gap:4px}
  .field label{font-family:var(--label);font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .tabs{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap}
  .tab{font-family:var(--label);font-size:13px;font-weight:600;border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;padding:6px 14px;cursor:pointer}
  .tab.active{background:var(--lightsage);color:var(--forest);border-color:var(--lightsage)}
  .chartbox{position:relative;height:190px}
  .small{font-family:var(--label);font-size:11px;color:var(--muted)}
  .pill{font-family:var(--label);font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:#eef1ec;color:var(--sage)}
  .foot{font-family:var(--label);font-size:11px;color:var(--muted);margin-top:30px;border-top:1px solid var(--line);padding-top:14px;line-height:1.8}
  @media(max-width:820px){.cards{grid-template-columns:repeat(2,1fr)}.grid2,.grid3{grid-template-columns:1fr}.vstage{grid-template-columns:80px 1fr;row-gap:8px}.vconv{grid-column:2;text-align:left}}
  #kwTableWrap table{font-size:12.5px}
  #kwTableWrap th{position:sticky;top:0;background:#f3f6f2;cursor:pointer;white-space:nowrap;z-index:1}
  #kwTableWrap th:hover{color:var(--forest)}
  #kwTableWrap td{padding:6px 10px}
  #kwTableWrap tr.t1 td:first-child{box-shadow:inset 3px 0 0 var(--sage)}
  .pospill{display:inline-block;min-width:30px;text-align:center;font-weight:700;border-radius:5px;padding:1px 6px;font-variant-numeric:tabular-nums}
  .pos-top3{background:#dff0e4;color:#1f6b3c}
  .pos-top10{background:#eef4ef;color:var(--sage)}
  .pos-low{background:#f1efe9;color:var(--muted)}
  .pos-none{color:#b9b9b9}
  .tierbadge{display:inline-block;font-size:10px;font-weight:700;border-radius:4px;padding:1px 5px}
  .tb1{background:#dff0e4;color:#1f6b3c}.tb2{background:#eef1ec;color:var(--sage)}.tb3{background:#f1efe9;color:var(--muted)}
  .tb4{background:#eaf0f5;color:#2C6FC4}
  .dlt-up{color:var(--good);font-weight:600}.dlt-dn{color:var(--bad);font-weight:600}.dlt-flat{color:#c2c2c2}
  .rate{font-family:var(--label);font-size:11px;color:var(--muted)}
  .rate b{color:var(--forest)}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">
      <h1>Mt. Baker Medical</h1>
      <div class="tag">Feel Better. Live Longer.</div>
      <div class="sub">Performance Dashboard · Concierge Growth</div>
    </div>
    <div class="hdr-right">
      <div>Concierge Primary Care · Bellingham, WA</div>
      <div style="margin-top:6px">
        <label class="small" for="periodSel">Period</label>
        <select id="periodSel"></select>
        <button class="btn sm ghost" id="refreshBtn" style="margin-left:8px">↻ Refresh live</button>
      </div>
    </div>
  </header>

  <!-- STATUS / FRESHNESS / ANOMALIES -->
  <div class="status">
    <div class="chips" id="srcChips"></div>
    <div id="alerts"></div>
  </div>

  <!-- NORTH STAR -->
  <h2 class="sec">Monthly Profitability<span class="rule"></span><span class="pill" id="finRange"></span></h2>
  <div class="cards" id="finance"></div>

  <h2 class="sec">North Star — Concierge Membership<span class="rule"></span><span class="pill" id="nsRange"></span></h2>
  <p class="sec-note" id="nsNote"></p>
  <div class="cards" id="northstar"></div>

  <!-- FUNNEL -->
  <h2 class="sec">Booking Funnel<span class="rule"></span><span class="pill" id="funnelRange"></span></h2>
  <p class="sec-note">The booking funnel, <b>people first</b>: every stage is unique people (GA4 totalUsers), with the raw event count muted beside it — events per person differ at every stage, so an events-only funnel lies. The window is the period since the 2026-07-18 <b>/book-beta</b> cutover shown in the pill above — the only period in which GA4 sees the flow end to end; the final stage is counted server-side. Booked consults and new members stay Hint's numbers — they are the North Star cards above.</p>
  <div class="small" id="reachLine" style="margin:0 0 8px;padding:8px 12px;background:#F1F4EF;border:1px solid var(--line);border-radius:10px;font-size:12px"></div>
  <!-- visits context strip (restored 2026-07-29) - deliberately OUTSIDE the funnel panel:
       visits are SESSIONS, the stages below are PEOPLE. -->
  <div class="panel" id="visitsStrip" style="margin:0 0 10px"></div>
  <div class="panel"><div class="funnel" id="funnel"></div></div>
  <div class="grid2" style="margin-top:14px">
    <div class="panel">
      <div class="small" style="font-weight:600;font-size:13px;color:var(--forest);margin-bottom:8px">Where prospects vanish <span class="smalltag">now measurable on-site</span></div>
      <div id="leakBox" class="small" style="font-size:12.5px;line-height:1.9"></div>
    </div>
    <div class="panel">
      <div class="small" style="margin-bottom:6px">Daily booking intent (Book/Call) — this month</div>
      <div class="small" id="dailyTapsBasis" style="margin-bottom:6px;font-size:11px;color:var(--stale);line-height:1.6"></div>
      <div class="chartbox" style="height:160px"><canvas id="chDaily"></canvas></div>
    </div>
  </div>
  <div class="panel" style="margin-top:14px">
    <div class="small" style="font-weight:600;font-size:13px;color:var(--forest);margin-bottom:8px">New members by lead source <span class="small" style="font-weight:400">— self-reported in Hint. At MBM's volume this is the primary attribution truth; GA4 last-click systematically undercredits referrals, GBP and word of mouth.</span></div>
    <div id="memSourceBar"></div>
    <div id="memSourceLegend" class="mixlegend" style="margin-top:8px"></div>
    <div class="small" id="memSourceNote" style="margin-top:8px"></div>
  </div>

  <!-- PAID -->
  <div class="panel" id="leadMagnet" style="margin-bottom:18px"></div>

  <h2 class="sec">Paid Channels<span class="rule"></span><span class="pill" id="paidRange"></span></h2>
  <p class="sec-note"><b>Google Ads is true month-to-date</b> (GAQL, API v21). "Ad-attributed taps" counts GA4-imported booking/phone actions from the <i>All conversions</i> column — immune to the primary/secondary goal misconfiguration that silently zeroed the Conversions column Jul 2–16. Meta &amp; Nextdoor are manual weekly pulls with their own as-of dates.</p>
  <div class="panel" style="margin-top:0;margin-bottom:14px">
    <div class="small" style="font-weight:600;font-size:13px;color:var(--forest);margin-bottom:4px">Channel economics — cost per person delivered to the booking flow <span class="smalltag">the money table</span></div>
    <div id="chanEcon"></div>
  </div>
  <div class="cards" id="paidCards"></div>
  <div class="grid2" style="margin-top:14px">
    <div class="panel"><div class="small" style="margin-bottom:6px">Google Ads campaigns — month-to-date</div><div id="campTable"></div></div>
    <div class="panel"><div class="small" style="margin-bottom:6px">Spend by platform — last 8 months</div><div class="chartbox"><canvas id="chSpend"></canvas></div></div>
  </div>
  <div class="panel" style="margin-top:14px" id="socialPanel"></div>

  <!-- GBP -->
  <h2 class="sec">Google Business Profile<span class="rule"></span><span class="pill" id="gbpPill">category experiment</span></h2>
  <p class="sec-note">Local-pack visibility and the <b>primary-category experiment</b> (switched "Family practice physician" → "Medical clinic" on 2026-07-16 to test pack eligibility for TRT/HRT/weight-loss intent). Pack positions are manual SERP reads — the 2026-08-06 readout re-measures all six. GBP engagement below comes from Google Ads "local actions" (the only GBP metrics reaching us via API today).</p>
  <div class="cards" id="gbpCards"></div>
  <div class="panel" style="margin-top:14px">
    <div class="small" style="font-weight:600;font-size:13px;color:var(--forest);margin-bottom:4px">Local pack tracker <span class="small" style="font-weight:400">— MBM position per pack, baseline (pre-change) vs latest re-measure</span></div>
    <div id="gbpPacks"></div>
    <div class="small" id="gbpNote" style="margin-top:10px;line-height:1.8"></div>
  </div>

  <!-- SEO -->
  <h2 class="sec">Website &amp; SEO<span class="rule"></span><span class="pill" id="seoLiveState">weekly snapshot</span></h2>
  <p class="sec-note">Google Search Console finalizes 2–3 days late — the current month is always partial. Recent dips are incomplete data, not real drops. <span class="small" id="seoSyncNote"></span></p>
  <div id="seoBody">
    <div class="cards" id="seoKpis" style="margin-bottom:14px"></div>
    <div class="grid2">
      <div class="panel"><div class="small" style="margin-bottom:2px">GSC clicks <span class="small" style="font-weight:400">— dashed = current month projected</span></div><div class="small" id="gscClicksPace" style="margin-bottom:6px;font-weight:400"></div><div class="chartbox" style="height:150px"><canvas id="chGscClicks"></canvas></div><div class="small" style="margin:14px 0 2px">GSC impressions</div><div class="small" id="gscImprPace" style="margin-bottom:6px;font-weight:400"></div><div class="chartbox" style="height:150px"><canvas id="chGscImpr"></canvas></div></div>
