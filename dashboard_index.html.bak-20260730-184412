       booking_click double-fired through 2026-07-28 and eventCount is inflated ~2.31x
       across that date, while totalUsers dedupes it away. */
    dimensions:[{name:"sessionDefaultChannelGroup"},{name:"eventName"}], metrics:[{name:"eventCount"},{name:"totalUsers"}],
    /* The booking-stage events are requested here so the live refresh returns them;
       the row loop below matches on eventName and simply ignores anything it has no
       branch for, so extra events cannot corrupt the parse. Stage counts still come
       from the baked SNAPSHOT (the daily task writes them) — see §2 of the metrics doc. */
    dimensionFilter:{filter:{fieldName:"eventName",inListFilter:{values:["session_start","phone_click","booking_click","booking_start","booking_step_1","booking_step_2","booking_complete_server","booking_unavailable"]}}}, limit:100 };
